<%- include("partials/head") %>

<main>
  <div class="container">
    <div class="card">
      <h1>Shorten Your URL</h1>
      <p class="subtitle">Paste a long URL and get a short link instantly.</p>

      <form action="/url/shortenUrl" id="shortenForm" method="post" class="url-form">
        <div class="input-group">
          <input type="url" name="fullUrl" id="fullUrl" required placeholder="https://example.com/very/long/url..." />
          <button type="submit">Shorten</button>
        </div>
      </form>

      <div class="result" id="result">
        <p>Your shortened URL:</p>
        <div class="short-url">
          <input id="short" type="text" readonly value="<%= shortUrl || '' %>">
          <button class="copy-btn" onclick="copyToClipboard()">Copy</button>
        </div>
      </div>
    </div>
  </div>
</main>

<script src="/js/script.js"></script>
</body>
</html>
