<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>URL Shortener</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header>
      <nav class="navbar">
        <h2 class="logo">URL-Shortner</h2>
        <a href="#database" class="nav-link" id="showDatabase"
          >See URL Database</a
        >
      </nav>
    </header>
    <main>
      <div class="container">
        <div class="card">
          <h1>Shorten Your URL</h1>
          <p class="subtitle">
            Paste a long URL and get a short link instantly.
          </p>
          <form action="/url/shortenUrl" method="post" class="url-form">
            <div class="input-group">
              <input
                type="url"
                name="fullUrl"
                id="fullUrl"
                placeholder="https://example.com/very/long/url..."
                required
              />
              <button type="submit">Shorten</button>
            </div>
          </form>

          <div class="result" id="result">
            <p>Your shortened URL:</p>
            <div class="short-url">
              <input id="short" type="text" readonly value=" <%= shortUrl || "" %>" />
              <button class="copy-btn" onclick="copyToClipboard()">Copy</button>
            </div>
          </div>
        </div>

        <div class="admin-log-card">
          <a href="/admin/loginPage" class="admin-log-btn">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
              <polyline points="10 17 15 12 10 7"></polyline>
              <line x1="15" y1="12" x2="3" y2="12"></line>
            </svg>
            Login as Admin
          </a>
        </div>
      </div>
    </main>
    <script src="/js/script.js">
    </script>
  </body>
</html>
