<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>URL Shortener</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header>
      <nav class="navbar">
        <h2 class="logo">URL-Shortner</h2>
        <a href="#database" class="nav-link" id="showDatabase"
          >See URL Database</a
        >
      </nav>
    </header>

    <main>
      <div class="container">     
        <div class="card">
          <h1>Shorten Your URL</h1>
          <p class="subtitle">
            Paste a long URL and get a short link instantly.
          </p>

          <form action="/url/shortenUrl" method="post" class="url-form">
            <div class="input-group">
              <input
                type="url"
                name="fullUrl"
                id="fullUrl"
                placeholder="https://example.com/very/long/url..."
                required
              />
              <button type="submit">Shorten</button>
            </div>
          </form>

          <div class="result hidden" id="result">
            <p>Your shortened URL:</p>
            <div class="short-url">
              <input type="text" readonly value="random" />
              <button class="copy-btn">Copy</button>
            </div>
          </div>
        </div>