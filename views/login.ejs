<%- include("partials/head") %>
<% if (typeof errors !== "undefined" && errors.length) { %>
  <div class="flash-errors">
    <% errors.forEach(function(e) { %>
      <p class="error"><%= e %></p>
    <% }); %>
  </div>
<% } %>
<main>
  <div class="container">
    <div class="login-card">
      <div class="login-header">
        <h1>Admin Access</h1>
        <p>Enter the secret admin code to continue</p>
      </div>

      <form action="/admin/login" id="adminLoginForm" method="post">
        <div class="input-wrapper">
          <input
            type="password"
            id="adminCode"
            name="code"
            placeholder="Enter secret code"
            autocomplete="off"
            required
          />
        </div>

        <button type="submit" class="login-btn">
          Enter Admin Panel
        </button>
      </form>
    </div>
  </div>
</main>
<script src="/js/script.js"></script>
</body>
</html>