<%- include("partials/head") %>
<main>
      <div class="container">     
      <div class="database-section" id="database">
        <div class="card">
          <h2>URL Database</h2>
          <div class="table-container">
            <table class="url-table">
              <thead>
                <tr>
                  <th>S.N</th>
                  <th>Original Link</th>
                  <th>Shortened Link</th>
                  <th>Times Visited</th>
                </tr>
              </thead>
              <tbody>
                <% urls.forEach((url, i) => { %>
                 <tr>
                  <td><%= i + 1 %> </td>
                  <td><a
                      href="<%= url.fullUrl %>"
                      target="_blank"
                      class="link"
                      ><%= url.fullUrl %></a
                    >
                  </td>
                  <td><a href="<%= url.fullUrl %>" class="short-link"><%= url.fullShortUrl %></a></td>
                  <td><%= url.visit %></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <div class="admin-log-card">
          <a href="/admin/logout" class="admin-log-btn">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
              <polyline points="10 17 15 12 10 7"></polyline>
              <line x1="15" y1="12" x2="3" y2="12"></line>
            </svg>
            Logout
          </a>
        </div>
    </div>
        <script src="/js/script.js">
      </script>
  </body>
</html>
