<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>URL Shortener</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header>
      <nav class="navbar">
        <h2 class="logo">URL-Shortner</h2>
        <a href="#database" class="nav-link" id="showDatabase">See URL Database</a>
      </nav>
    </header>

    <main>
      <div class="container">
        <div class="card">
          <h1>Shorten Your URL</h1>
          <p class="subtitle">
            Paste a long URL and get a short link instantly.
          </p>

          <form action="" method="post" class="url-form">
            <div class="input-group">
              <input
                type="url"
                name="fullUrl"
                id="fullUrl"
                placeholder="https://example.com/very/long/url..."
                required
              />
              <button type="submit">Shorten</button>
            </div>
          </form>

          <div class="result hidden" id="result">
            <p>Your shortened URL:</p>
            <div class="short-url">
              <input type="text" readonly value="short.url/abc123" />
              <button class="copy-btn">Copy</button>
            </div>
          </div>
        </div>

        <div class="database-section" id="database">
          <div class="card">
            <h2>URL Database</h2>
            <div class="table-container">
              <table class="url-table">
                <thead>
                  <tr>
                    <th>S.N</th>
                    <th>Original Link</th>
                    <th>Shortened Link</th>
                    <th>Clicks</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>1</td>
                    <td><a href="https://verylongexample.com/path/to/some/page" target="_blank" class="link">verylongexample.com/path/to/...</a></td>
                    <td><a href="#" class="short-link">short.url/abc123</a></td>
                    <td>42</td>
                  </tr>
                  <tr>
                    <td>2</td>
                    <td><a href="https://anotherlongurl.com" target="_blank" class="link">anotherlongurl.com</a></td>
                    <td><a href="#" class="short-link">short.url/xyz789</a></td>
                    <td>19</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p class="no-data hidden" id="noData">No URLs shortened yet.</p>
          </div>
        </div>
      </div>
    </main>

    <script src="/js/script.js"></script>
  </body>
</html>