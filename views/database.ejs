<%- include("partials/head") %>
<main>
      <div class="container">     
        <div class="card">
          <h1>Shorten Your URL</h1>
          <p class="subtitle">
            Paste a long URL and get a short link instantly.
          </p>

          <form action="/url/admin/shortenUrl" method="post" class="url-form">
            <div class="input-group">
              <input
                type="url"
                name="fullUrl"
                id="fullUrl"
                placeholder="https://example.com/very/long/url..."
                required
              />
              <button type="submit">Shorten</button>
            </div>
          </form>

          <div class="result" id="result">
            <p>Your shortened URL:</p>
            <div class="short-url">
              <input id="short" type="text" readonly value=" <%= shortUrl || "" %>" />
              <button class="copy-btn" onclick="copyToClipboard()">Copy</button>
            </div>
          </div>
        </div>
      <div class="database-section" id="database">
        <div class="card">
          <h2>URL Database</h2>
          <div class="table-container">
            <table class="url-table">
              <thead>
                <tr>
                  <th>S.N</th>
                  <th>Original Link</th>
                  <th>Shortened Link</th>
                  <th>Times Visited</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>1</td>
                  <td>
                    <a
                      href="https://verylongexample.com/path/to/some/page"
                      target="_blank"
                      class="link"
                      >verylongexample.com/path/to/...</a
                    >
                  </td>
                  <td><a href="#" class="short-link">short.url/abc123</a></td>
                  <td>42</td>
                </tr>
                <tr>
                  <td>2</td>
                  <td>
                    <a
                      href="https://anotherlongurl.com"
                      target="_blank"
                      class="link"
                      >anotherlongurl.com</a
                    >
                  </td>
                  <td><a href="#" class="short-link">short.url/xyz789</a></td>
                  <td>19</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="no-data hidden" id="noData">No URLs shortened yet.</p>
        </div>
      </div>
    </div>
        <script src="/js/script.js">
      </script>
  </body>
</html>
